{
  "files.associations": {
    "*.s": "asm-intel-x86-generic"
  },
  "japanese-proofreading.textlint.かっこ類と隣接する文字の間のスペースの有無": false,
  "json.schemas": [
    {
      "fileMatch": ["assets/classes/*.json"],
      "url": "./assets/havok_class_schema.json"
    },
    {
      "fileMatch": ["assets/for_table/*.json"],
      "url": "./assets/havok_class_schema.json"
    }
  ],
  "rumdl.rules.disable": ["MD033", "MD013", "MD007", "no-hard-tabs"],
  "rust-analyzer.check.command": "clippy",
  "toml.formatter.alignEntries": true
}
